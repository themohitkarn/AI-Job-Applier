# ==============================================================================
# AI AUTO JOB APPLY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and customize values for your local environment.
# DO NOT commit real secrets or credentials into version control.
# ==============================================================================

# --- Application Settings ---
APP_NAME="AI Auto Job Apply"
APP_ENV="development"
DEBUG=true
HOST="127.0.0.1"
PORT=8000
LOG_LEVEL="INFO"
SECRET_KEY="replace-with-a-secure-random-secret-key-for-production"

# --- Database & Persistence ---
# SQLite async database file path (relative or absolute)
DATABASE_URL="sqlite+aiosqlite:///./data/job_assistant.db"

# --- AI Provider Configuration ---
# Active provider: "groq" (default) or "ollama"
AI_PROVIDER="groq"

# Groq Settings (Default Cloud Provider)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b" # High-speed open-weight MoE model on Groq (or "gpt-oss-120b")
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=2048
GROQ_TIMEOUT=45.0
GROQ_MAX_RETRIES=3

# Ollama Settings (Optional Local Provider)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_TIMEOUT=60.0
AI_ENABLE_FALLBACK=false

# --- Job Discovery & Connectors ---
# Comma-separated list of enabled connectors
# Supported automated APIs: remoteok, jobicy, arbeitnow, greenhouse, lever, ashby, smartrecruiters
# Supported assisted link imports: linkedin, internshala, glassdoor
ENABLED_CONNECTORS="remoteok,jobicy,arbeitnow,greenhouse"
JOB_SEARCH_KEYWORDS="python,developer,engineer,backend,fastapi"
JOB_SEARCH_LOCATION="" # Empty string means worldwide / all locations unrestricted
ALLOWED_WORK_MODES="remote,hybrid,on-site"
PRIORITIZE_FRESHERS=true
FRESHER_BONUS_SCORE=15.0
MIN_MATCH_SCORE=35.0
# Optional JSON override for skill & title taxonomies:
# KEYWORD_GROUPS_JSON='{"ai_ml":["AI Engineer","GenAI Developer"],"python_backend":["Python Developer","FastAPI Developer"]}'
JOB_SYNC_INTERVAL_MINUTES=60
JOB_CONNECTOR_MAX_RESULTS=50
JOB_REQUEST_TIMEOUT=20.0

# Employer ATS Career Board Targets (Comma-separated employer board tokens)
GREENHOUSE_BOARDS="gitlab,cloudflare"
LEVER_COMPANIES="deliveroo"
ASHBY_ORGANIZATIONS=""
SMARTRECRUITERS_COMPANIES=""

# --- File Storage & Document Paths ---
DATA_DIR="./data"
RESUME_STORAGE_DIR="./data/resumes"
GENERATED_DOCS_DIR="./data/generated"
CACHE_DIR="./data/cache"
SCREENSHOTS_DIR="./data/screenshots"
MAX_UPLOAD_SIZE_MB=10

# --- Browser Automation (Playwright) ---
BROWSER_HEADLESS=true
BROWSER_TYPE="chromium"
BROWSER_TIMEOUT_MS=30000
BROWSER_SLOW_MO_MS=100
BROWSER_REQUIRE_USER_APPROVAL=true

# --- Background Task Scheduler ---
ENABLE_SCHEDULER=true
SCHEDULER_CHECK_INTERVAL_SECONDS=60
SCHEDULER_CACHE_CLEANUP_HOURS=24

# --- Security & CORS ---
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost:8501,http://127.0.0.1:8501"

# --- Email Outreach (Preserved from legacy app.py) ---
SENDER_EMAIL=""
SENDER_PASSWORD=""
